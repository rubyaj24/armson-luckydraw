# Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Event
EVENT_SLUG=armson-festival-2026
ADMIN_EMAIL=admin@example.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me

# Resend
RESEND_API_KEY=re_replace_me
WINNER_FROM_EMAIL=Lucky Draw <winner@mail.example.com>
WINNER_REPLY_TO=admin@example.com

# Protect the notification retry endpoint used by Vercel Cron
CRON_SECRET=replace_with_a_long_random_value
